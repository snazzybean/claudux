node_modules/
# The previous modules, kept aside by an update until the restart (see
# src/lib/updateRun.js). Untracked here it would leave the tree dirty, and
# the next update refuses to run on a dirty tree - one update would have
# blocked every one after it.
node_modules.old
.env
.local/
data/
*.log
/test-*.txt
/temp-*

# Local working documents, not part of the published project.
CLAUDE.md
TODO.md
GITHUB-READINESS.md
OPEN-DECISIONS.md

# Agent-local state. Listed here rather than left to a global ignore file,
# so the repo carries the rule itself.
.claude/
.superpowers/

# A local pre-push secret scan, wired in by hand via core.hooksPath. Not
# shipped: it only ever runs in the clone that pushes, so it protects this
# checkout and no other - while its mere presence as a `prepare` script made
# every `npx github:` install pull the devDependencies.
.git-hooks/
