PORT=4001
# defaults to 0.0.0.0 (every interface), with the login in front of it.
# 127.0.0.1 closes it down to this machine, which is what a proxy on the
# same host wants - see README's Security
# HOST=127.0.0.1
# defaults to $HOME/.claude
# CLAUDE_HOME=/custom/path/.claude
# defaults to $HOME/.claudux/data; set here on purpose, because a checkout
# keeps its own data in the checkout
DATA_DIR=./data
# defaults to $HOME/.claudux/accounts.json
# ACCOUNTS_SECRET_PATH=/custom/path/accounts.json
# the login, on unless this says false in so many words. Off is for
# installations where a proxy, a VPN or Tailscale authenticates instead.
# AUTH_ENABLED=false
# site password and sessions, defaults to $HOME/.claudux/access.json
# ACCESS_SECRET_PATH=/custom/path/access.json
# root for the "+ Add folder" browse dialog, defaults to $HOME
# PROJECTS_BROWSE_ROOT=/home/you/code
# defaults to $HOME/.claudux/notifications.json
# NOTIFICATION_TARGETS_PATH=/custom/path/notifications.json
IDLE_THRESHOLD_MS=14400000
UNUSED_IDLE_THRESHOLD_MS=1800000
# abandoned "claude setup-token" sessions, their screen shows a token
# LOGIN_IDLE_THRESHOLD_MS=900000
# base of the notification's click link
# PUBLIC_BASE_URL=https://your-domain.example
# defaults to $HOME/.claudux/vapid.json - created on first use, deleting it
# unsubscribes every device
# VAPID_KEYS_PATH=/custom/path/vapid.json
# `sub` claim of the push token; defaults to the origin of PUBLIC_BASE_URL,
# and to the repository url when that is unset too
# VAPID_SUBJECT=https://your-domain.example
TTYD_PORT=7681
# only if ttyd is not on PATH
# TTYD_BIN=/usr/local/bin/ttyd
